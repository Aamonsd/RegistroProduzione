<Window x:Class="RegistroProduzione.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RegistroProduzione.Wpf.ViewModels"
        xmlns:views="clr-namespace:RegistroProduzione.Wpf.Views"
        mc:Ignorable="d"
        Title="Registro produzione" Height="760" Width="1240" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Language="it-IT">
    <!-- Language="it-IT": numeri e date formattati all'italiana (25,0% e non 25.0%) -->

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MacchineViewModel}">
            <views:MacchineView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegistraProduzioneViewModel}">
            <views:RegistraProduzioneView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RiepilogoViewModel}">
            <views:RiepilogoView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Rectangle Grid.Column="0" Fill="{StaticResource ColoreScuro}"/>
        <Rectangle Grid.Column="1" Fill="{StaticResource ColoreSfondo}"/>

        <!-- Menu laterale -->
        <StackPanel Margin="16,28,16,0">
            <!-- Logo -->
            <StackPanel Orientation="Horizontal" Margin="8,0,0,32">
                <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource ColorePrimario}">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconaLogo}" Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <TextBlock Text="Produzione" FontSize="17" FontWeight="Bold" Foreground="White"
                           FontFamily="{StaticResource FontTitoli}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Voci: RadioButton così ne resta evidenziata una sola -->
            <RadioButton Content="Macchine" Command="{Binding MostraMacchineCommand}"
                         Style="{StaticResource VoceMenu}" Tag="{StaticResource IconaMacchine}" IsChecked="True"/>
            <RadioButton Content="Registra produzione" Command="{Binding MostraRegistraProduzioneCommand}"
                         Style="{StaticResource VoceMenu}" Tag="{StaticResource IconaRegistra}"/>
            <RadioButton Content="Riepilogo" Command="{Binding MostraRiepilogoCommand}"
                         Style="{StaticResource VoceMenu}" Tag="{StaticResource IconaRiepilogo}"/>
        </StackPanel>

        <!-- Schermata corrente -->
        <ContentControl Grid.Column="1" Content="{Binding ViewModelCorrente}"/>
    </Grid>
</Window>
