<Window x:Class="RegistroProduzione.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RegistroProduzione.Wpf"
        mc:Ignorable="d"
        xmlns:vm="clr-namespace:RegistroProduzione.Wpf.ViewModels"
        xmlns:views="clr-namespace:RegistroProduzione.Wpf.Views"

        Title="Registro produzione" Height="600" Width="1050">
    

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MacchineViewModel}">
            <views:MacchineView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegistraProduzioneViewModel}">
            <views:RegistraProduzioneView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RiepilogoViewModel}" >
            <views:RiepilogoView/>
        </DataTemplate>
        
        
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <!-- Menu a sinistra -->
        <StackPanel Background="#F0F0F0">
            <Button Content="Macchine" Width="160" Height="40" Margin="10,20,10,10" Command="{Binding MostraMacchineCommand}"/>
            <Button Content="Registra produzione" Width="160" Height="40" Margin="10,0,10,10" Command="{Binding MostraRegistraProduzioneCommand}"/>
            <Button Content="Riepilogo" Width="160" Height="40" Margin="10,0,10,10" Command="{Binding MostraRiepilogoCommand}"/>
        </StackPanel>
        <ContentControl Grid.Column="1" Content="{Binding ViewModelCorrente}"></ContentControl>

    </Grid>
</Window>
