<UserControl x:Class="RegistroProduzione.Wpf.Views.RegistraProduzioneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:servizi="clr-namespace:RegistroProduzione.Core.Services;assembly=RegistroProduzione.Core"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="44,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Intestazione -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Registra produzione" Style="{StaticResource TitoloPagina}"/>
            <TextBlock Text="Inserisci i pezzi prodotti da una macchina in un turno" Style="{StaticResource SottotitoloPagina}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card sinistra: il form -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="32" VerticalAlignment="Top">
                <StackPanel>
                    <!-- Macchina -->
                    <TextBlock Text="Macchina" Style="{StaticResource EtichettaCampo}"/>
                    <ComboBox ItemsSource="{Binding Macchine}" SelectedItem="{Binding MacchinaSelezionata}"
                              Style="{StaticResource CampoScelta}" Margin="0,0,0,22">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Codice, Mode=OneWay}" FontFamily="Consolas"/><Run Text="  ·  "/><Run Text="{Binding Nome, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Data e turno affiancati -->
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Data" Style="{StaticResource EtichettaCampo}"/>
                            <DatePicker SelectedDate="{Binding Data}" Style="{StaticResource CampoData}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Turno" Style="{StaticResource EtichettaCampo}"/>
                            <ComboBox ItemsSource="{Binding Turni}" SelectedItem="{Binding TurnoSelezionato}"
                                      Style="{StaticResource CampoScelta}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Pezzi buoni e scartati affiancati -->
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Pezzi buoni" Style="{StaticResource EtichettaCampo}"/>
                            <TextBox Text="{Binding PezziBuoni}" Style="{StaticResource CampoTesto}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Pezzi scartati" Style="{StaticResource EtichettaCampo}"/>
                            <TextBox Text="{Binding PezziScartati}" Style="{StaticResource CampoTesto}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Messaggi: un TextBlock vuoto non occupa spazio -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{Binding MessaggioErrore}" Style="{StaticResource Messaggio}" Foreground="{StaticResource ColoreErrore}"/>
                        <TextBlock Text="{Binding MessaggioEsito}" Style="{StaticResource Messaggio}" Foreground="{StaticResource ColoreSuccesso}"/>
                        <TextBlock Text="{Binding AvvisoScarto}" Style="{StaticResource Messaggio}" Foreground="{StaticResource ColoreAvviso}" FontWeight="SemiBold"/>
                    </StackPanel>

                    <Button Content="Registra produzione" Command="{Binding RegistraCommand}"
                            Style="{StaticResource PulsantePrimario}" Background="{StaticResource ColoreScuro}" FontSize="15"/>
                </StackPanel>
            </Border>

            <!-- Card destra: la macchina scelta -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="28" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="MACCHINA SELEZIONATA" Style="{StaticResource IntestazioneColonna}" Margin="0,0,0,18"/>

                    <!-- Se non è selezionata nessuna macchina, mostra un invito -->
                    <TextBlock Text="Scegli una macchina dal menu a tendina.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SottotitoloPagina}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MacchinaSelezionata}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding MacchinaSelezionata.Nome}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource ColoreScuro}" FontFamily="{StaticResource FontTitoli}"/>
                    <TextBlock Text="{Binding MacchinaSelezionata.Codice}" FontSize="13" FontFamily="Consolas"
                               Foreground="{StaticResource ColoreTestoSecondario}" Margin="0,2,0,18"/>

                    <Border BorderBrush="#EEF0F3" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Reparto" FontSize="13" Foreground="{StaticResource ColoreTestoSecondario}"/>
                                <TextBlock Text="{Binding MacchinaSelezionata.Reparto}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource ColoreScuro}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Soglia di scarto" FontSize="13" Foreground="{StaticResource ColoreTestoSecondario}"/>
                                <!-- x:Static legge direttamente la costante pubblica del servizio -->
                                <TextBlock Text="{Binding Source={x:Static servizi:ServizioProduzione.SogliaScarto}, StringFormat={}{0:0.#}%}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ColoreScuro}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
